#!/bin/bash
# Timeline App - 自解压安装包
set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
INSTALL_DIR="$SCRIPT_DIR/timeline-app-fuxiang"

echo "=========================================="
echo "  Timeline App"
echo "=========================================="
echo ""

if ! command -v node >/dev/null 2>&1; then
    echo "❌ 未检测到 Node.js"
    echo "   请先安装：https://nodejs.org  (或 brew install node)"
    echo ""
    read -p "按回车键退出..." _
    exit 1
fi

echo "✓ Node.js: $(node --version)"
echo "✓ 安装位置: $INSTALL_DIR"
echo ""

mkdir -p "$INSTALL_DIR"

# 备份用户数据 (如果已存在)
DATA_BACKUP=""
if [ -f "$INSTALL_DIR/data.json" ] && [ "$(cat "$INSTALL_DIR/data.json")" != '{"mainLines":[]}' ]; then
    DATA_BACKUP=$(mktemp)
    cp "$INSTALL_DIR/data.json" "$DATA_BACKUP"
    echo "💾 已备份现有数据"
fi

echo "📦 更新源码..."
ARCHIVE_LINE=$(awk '/^__ARCHIVE_BELOW__$/{print NR + 1; exit}' "$0")
tail -n +"$ARCHIVE_LINE" "$0" | base64 -d | tar -xz -C "$INSTALL_DIR"

# 恢复用户数据
if [ -n "$DATA_BACKUP" ]; then
    cp "$DATA_BACKUP" "$INSTALL_DIR/data.json"
    rm -f "$DATA_BACKUP"
    echo "♻️  已恢复你的数据"
fi

cd "$INSTALL_DIR"

if [ ! -d "node_modules" ]; then
    echo ""
    echo "📥 首次安装依赖 (约 1-2 分钟)..."
    npm install --no-audit --no-fund
fi

echo ""
echo "🚀 启动 Timeline App..."
echo ""
npm start

exit 0
__ARCHIVE_BELOW__

